extends Node
## Sound effects: two pools of non-positional AudioStreamPlayers on the SFX bus
## and an id -> stream registry. The comms_* ids (COMMS_SFX) play on a small
## reserved comms pool, every other id on the combat pool (DW-80). When every
## player of a pool is busy, that pool's oldest player is stolen; a pool never
## takes a player from the other, so a combat flood can't cut a comms_static.
## Story 8.1: every id has its own file. The combat sounds are CC0 Kenney
## sounds imported by tools/import_cc0_audio.py; the comms cues and maul_alarm
## are generated by tools/gen_placeholder_sfx.py; comms_static is a CC0
## recording (sources in assets/CREDITS.md).
##
## Music (Story 5.3): one `Music` AudioStreamPlayer on the Music bus and the
## `music_streams` id -> stream registry, which starts as a copy of the
## preloaded MUSIC tracks (Story 8.1: CC0, imported looping) and plays at
## audio.music_volume_db. apply_music_action() is the WaveDirector `music`
## action: `stop` fades out over audio.music_fade_out_s, any other id plays (or
## switches to) that track. A missing stream warns once per id, stops the
## current music at once and stays silent.
##
## Playtest pt7-e: each track plays at audio.music_volume_db plus its optional
## audio.music_gain_db.<id>. Playtest pt7-k: two music players. Every start
## fades in (audio.music_fade_in_s), every stop fades out (audio.music_fade_out_s)
## and a switch from an audible track crossfades over audio.music_crossfade_s,
## the new track starting on the idle player (play_music's fade_in_s of 0 is a
## hard cut). The title and Level Select play MENU_MUSIC.
## play_sfx_solo() stops any combat-pool copy of the same id before playing, so
## a burst of one cue (the energy orb) never stacks.

const DEFAULT_PITCH_JITTER: float = 0.05
const POOL_SIZE: int = 12
## The reserved comms pool (DW-80): comms cues are sequential by design, so the
## second player only covers a short cue overlapping a long one.
const COMMS_POOL_SIZE: int = 2
const SFX_BUS: StringName = &"SFX"
const MUSIC_BUS: StringName = &"Music"
const MUSIC_STOP: StringName = &"stop"
## The volume a fade-out tweens the music player down to before stopping it.
const MUSIC_SILENT_DB: float = -80.0
const SFX: Dictionary[StringName, AudioStream] = {
	&"laser_zap": preload("res://assets/audio/sfx/sfx_laser_zap.wav"),
	&"missile_launch": preload("res://assets/audio/sfx/sfx_missile_launch.wav"),
	&"explosion_small": preload("res://assets/audio/sfx/sfx_explosion_small.wav"),
	&"explosion_medium": preload("res://assets/audio/sfx/sfx_explosion_medium.wav"),
	&"explosion_large": preload("res://assets/audio/sfx/sfx_explosion_large.wav"),
	&"explosion_mid": preload("res://assets/audio/sfx/sfx_explosion_mid.wav"),
	&"explosion_boss_death": preload("res://assets/audio/sfx/sfx_explosion_boss_death.wav"),
	&"player_hit": preload("res://assets/audio/sfx/sfx_player_hit.wav"),
	&"player_death": preload("res://assets/audio/sfx/sfx_player_death.wav"),
	&"shield_on": preload("res://assets/audio/sfx/sfx_shield_on.wav"),
	&"energy_pickup": preload("res://assets/audio/sfx/sfx_energy_pickup.wav"),
	&"needle_fire": preload("res://assets/audio/sfx/sfx_needle_fire.wav"),
	&"ability_denied": preload("res://assets/audio/sfx/sfx_ability_denied.wav"),
	&"barrage_whoosh": preload("res://assets/audio/sfx/sfx_barrage_whoosh.wav"),
	&"comms_open": preload("res://assets/audio/sfx/sfx_comms_open.wav"),
	&"comms_open_nobeep": preload("res://assets/audio/sfx/sfx_comms_open_nobeep.wav"),
	&"comms_static": preload("res://assets/audio/sfx/sfx_comms_static.wav"),
	&"comms_click": preload("res://assets/audio/sfx/sfx_comms_click.wav"),
	&"comms_handover": preload("res://assets/audio/sfx/sfx_comms_handover.wav"),
	&"maul_alarm": preload("res://assets/audio/sfx/sfx_maul_alarm.wav"),
	# Tarek's burning fall (playtest pt7-j), a layered CC0 build.
	&"tarek_burn": preload("res://assets/audio/sfx/sfx_tarek_burn.wav"),
}
## The shipped music tracks (Story 8.1), imported with loop on, except the
## one-shot `game_over` sting (playtest pt7-g), which plays once under the retry
## prompt. Each campaign level has its own track (playtest pt7-i: `level_1`,
## `level_2`, `level_3`; the old shared `combat` track is retired). The ids are
## the LevelValidator MUSIC_ACTIONS other than `stop`.
const MUSIC: Dictionary[StringName, AudioStream] = {
	&"level_1": preload("res://assets/audio/music/music_level_1.ogg"),
	&"level_2": preload("res://assets/audio/music/music_level_2.ogg"),
	&"level_3": preload("res://assets/audio/music/music_level_3.ogg"),
	&"boss": preload("res://assets/audio/music/music_boss.ogg"),
	&"epilogue": preload("res://assets/audio/music/music_epilogue.ogg"),
	&"game_over": preload("res://assets/audio/music/music_game_over.ogg"),
	# The title and Level Select track (playtest pt7-k).
	&"menu": preload("res://assets/audio/music/music_menu.ogg"),
}
## The title and Level Select track (playtest pt7-k).
const MENU_MUSIC: StringName = &"menu"
## The music ids that play once instead of looping (their import has loop off).
const ONE_SHOT_MUSIC: Array[StringName] = [&"game_over"]
## The ids that play on the comms pool; every other id plays on the combat pool.
const COMMS_SFX: Dictionary[StringName, bool] = {
	&"comms_open": true,
	&"comms_open_nobeep": true,
	&"comms_static": true,
	&"comms_click": true,
	&"comms_handover": true,
}

## The combat pool.
var _players: Array[AudioStreamPlayer] = []
var _in_use: Array[bool] = []
## Start order of each player; the lowest is the oldest.
var _serials: Array[int] = []
## The reserved comms pool (same layout as the combat pool).
var _comms_players: Array[AudioStreamPlayer] = []
var _comms_in_use: Array[bool] = []
var _comms_serials: Array[int] = []
## Shared by both pools: every play bumps it by exactly 1.
var _next_serial: int = 0
var _newest: AudioStreamPlayer = null
var _warned_ids: Dictionary[StringName, bool] = {}

## Music id -> stream: a copy of MUSIC, so tests can swap or remove entries.
var music_streams: Dictionary[StringName, AudioStream] = MUSIC.duplicate()
## The two music players (playtest pt7-k): `_music` is the active one (the
## current or last-started track), `_music_other` the one a crossfade is
## fading out. A new track always starts on the idle one, so a crossfade never
## hands a playing stream from one player to the other.
var _music: AudioStreamPlayer
var _music_other: AudioStreamPlayer
## The id playing now; &"" when silent or fading out.
var _music_id: StringName = &""
var _music_base_db: float = 0.0
## Player -> its running volume tween (a fade-in, a fade-out or a crossfade leg).
var _music_tweens: Dictionary[AudioStreamPlayer, Tween] = {}
var _warned_music: Dictionary[StringName, bool] = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i: int in POOL_SIZE:
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.name = "Sfx%d" % i
		player.bus = SFX_BUS
		player.finished.connect(_on_player_finished.bind(i))
		add_child(player)
		_players.append(player)
		_in_use.append(false)
		_serials.append(-1)
	for i: int in COMMS_POOL_SIZE:
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.name = "Comms%d" % i
		player.bus = SFX_BUS
		player.finished.connect(_on_comms_player_finished.bind(i))
		add_child(player)
		_comms_players.append(player)
		_comms_in_use.append(false)
		_comms_serials.append(-1)
	# Config is an earlier autoload, so the tuning is loaded here.
	_music_base_db = Config.num("audio.music_volume_db")
	_music = _make_music_player("Music")
	_music_other = _make_music_player("MusicCrossfade")


## Plays a registered SFX. pitch_scale = pitch * (1 + random in +-pitch_jitter).
## comms_* ids (COMMS_SFX) play on the comms pool, every other id on the combat
## pool. Returns the player used, or null for an unknown id (warned once per id).
func play_sfx(id: StringName, pitch_jitter: float = DEFAULT_PITCH_JITTER, volume_db: float = 0.0, pitch: float = 1.0) -> AudioStreamPlayer:
	var stream: AudioStream = SFX.get(id) as AudioStream
	if stream == null:
		if not _warned_ids.has(id):
			_warned_ids[id] = true
			Log.warn("audio", "unknown sfx id '%s'" % id)
		return null
	var comms: bool = COMMS_SFX.has(id)
	var players: Array[AudioStreamPlayer] = _comms_players if comms else _players
	var in_use: Array[bool] = _comms_in_use if comms else _in_use
	var serials: Array[int] = _comms_serials if comms else _serials
	if players.is_empty():
		return null
	var index: int = _pick_player(players, in_use, serials)
	var player: AudioStreamPlayer = players[index]
	if player.playing:
		player.stop()
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = pitch * (1.0 + randf_range(-pitch_jitter, pitch_jitter))
	in_use[index] = true
	serials[index] = _next_serial
	_next_serial += 1
	_newest = player
	player.play()
	return player


## As play_sfx, but first stops every combat-pool player still playing this id's
## stream, so rapid repeats replace each other instead of stacking (playtest
## pt7-e). Comms ids play as play_sfx.
func play_sfx_solo(id: StringName, pitch_jitter: float = DEFAULT_PITCH_JITTER, volume_db: float = 0.0, pitch: float = 1.0) -> AudioStreamPlayer:
	var stream: AudioStream = SFX.get(id) as AudioStream
	if stream != null and not COMMS_SFX.has(id):
		for i: int in _players.size():
			if _in_use[i] and _players[i].stream == stream:
				_players[i].stop()
				# stop() never emits `finished`, so free the slot here.
				_in_use[i] = false
	return play_sfx(id, pitch_jitter, volume_db, pitch)


## The most recently started player of either pool (tests), or null before the
## first play.
func newest_player() -> AudioStreamPlayer:
	return _newest


## The reserved comms pool's players (tests).
func comms_players() -> Array[AudioStreamPlayer]:
	return _comms_players.duplicate()


## The pool's first free player, else its one with the oldest start serial.
func _pick_player(players: Array[AudioStreamPlayer], in_use: Array[bool], serials: Array[int]) -> int:
	var oldest: int = 0
	for i: int in players.size():
		if not in_use[i]:
			return i
		if serials[i] < serials[oldest]:
			oldest = i
	return oldest


func _on_player_finished(index: int) -> void:
	_in_use[index] = false


func _on_comms_player_finished(index: int) -> void:
	_comms_in_use[index] = false


# --- Music ----------------------------------------------------------------------

## The WaveDirector `music` action: &"stop" fades the music out, any other value
## plays that track (with the default fade-in or crossfade).
func apply_music_action(action: StringName) -> void:
	if action == MUSIC_STOP:
		stop_music()
	else:
		play_music(action)


## Plays music `id`. Does nothing when `id` already plays (or fades in).
##
## `fade_in_s` (playtest pt7-k): a negative value uses the defaults, a
## crossfade over audio.music_crossfade_s when a track is still audible (also
## one fading out), else a fade-in over audio.music_fade_in_s; a positive value
## fades the new track in over that many seconds (the old one, if any, still
## fades out over audio.music_crossfade_s); 0 is a hard cut: the old track
## stops at once and the new one starts at its volume.
##
## The same track still fading out on the active player is faded back in where
## it is, not restarted. A missing stream warns once per id, stops all music at
## once and leaves it silent. Fades ignore time_scale, so a hit-stop never
## freezes them.
func play_music(id: StringName, fade_in_s: float = -1.0) -> void:
	# A fade-out clears _music_id, so a match is this track playing or fading in.
	if id == _music_id:
		return
	# Re-read, so an F5 reload applies a retuned volume on the next play.
	_music_base_db = Config.num("audio.music_volume_db")
	var stream: AudioStream = music_streams.get(id) as AudioStream
	if stream == null:
		if not _warned_music.has(id):
			_warned_music[id] = true
			Log.warn("audio", "no music stream for '%s'; music stays silent" % id)
		_stop_player(_music)
		_stop_player(_music_other)
		_music_id = &""
		return
	var target_db: float = _music_base_db + music_gain_db(id)
	var audible: bool = _music.playing
	if audible and _music.stream == stream:
		# The same track fading out: bring it back where it is.
		var back_s: float = fade_in_s if fade_in_s >= 0.0 else Config.num("audio.music_fade_in_s")
		_music_id = id
		_fade_player(_music, target_db, back_s, false)
		_log_play(id, back_s)
		return
	var fade: float = fade_in_s
	if fade < 0.0:
		fade = Config.num("audio.music_crossfade_s") if audible else Config.num("audio.music_fade_in_s")
	# An older fade-out still running on the idle player ends now.
	_stop_player(_music_other)
	if audible:
		if fade_in_s == 0.0:
			_stop_player(_music)
		else:
			_fade_player(_music, MUSIC_SILENT_DB, Config.num("audio.music_crossfade_s"), true)
	var next: AudioStreamPlayer = _music_other
	_music_other = _music
	_music = next
	_music.stream = stream
	_music_id = id
	if fade > 0.0:
		_music.volume_db = MUSIC_SILENT_DB
		_music.play()
		_fade_player(_music, target_db, fade, false)
	else:
		_music.volume_db = target_db
		_music.play()
	_log_play(id, fade)


## The extra gain of music `id` (audio.music_gain_db.<id>, 0 when absent), so a
## quiet track sits level with the others.
func music_gain_db(id: StringName) -> float:
	var gains: Variant = Config.section("audio").get("music_gain_db", {})
	if not (gains is Dictionary):
		return 0.0
	var gain: Variant = (gains as Dictionary).get(String(id), 0.0)
	return float(gain) if gain is float or gain is int else 0.0


## Fades the music out over `fade_s` seconds (a negative value uses
## audio.music_fade_out_s), then stops it and restores the base volume. A fade
## of 0 stops every music player at once; with nothing playing it only clears
## the current id (a crossfade's outgoing leg keeps fading).
## current_music() is &"" from this call on.
func stop_music(fade_s: float = -1.0) -> void:
	var fade: float = fade_s if fade_s >= 0.0 else Config.num("audio.music_fade_out_s")
	var was: StringName = _music_id
	_music_id = &""
	if fade <= 0.0:
		if not was.is_empty():
			Log.info("audio", "Music '%s' stopping (0.00 s fade)" % was)
		_stop_player(_music)
		_stop_player(_music_other)
		return
	if was.is_empty():
		return
	Log.info("audio", "Music '%s' stopping (%.2f s fade)" % [was, fade])
	_fade_player(_music, MUSIC_SILENT_DB, fade, true)


## The music id playing now (&"" when silent or fading out).
func current_music() -> StringName:
	return _music_id


## The active music player: the current or last-started track (tests).
func music_player() -> AudioStreamPlayer:
	return _music


## Both music players, active first (tests).
func music_players() -> Array[AudioStreamPlayer]:
	return [_music, _music_other]


func _make_music_player(player_name: String) -> AudioStreamPlayer:
	var player: AudioStreamPlayer = AudioStreamPlayer.new()
	player.name = player_name
	player.bus = MUSIC_BUS
	player.volume_db = _music_base_db
	# A one-shot track (game_over) ending leaves the music silent, so a later
	# play_music of the same id starts it again.
	player.finished.connect(_on_music_finished.bind(player))
	add_child(player)
	return player


## Tweens `player`'s volume to `to_db` over `seconds` (at once for 0); with
## `stop_at_end` the player then stops and returns to the base volume.
func _fade_player(player: AudioStreamPlayer, to_db: float, seconds: float, stop_at_end: bool) -> void:
	_kill_fade(player)
	if seconds <= 0.0:
		if stop_at_end:
			_stop_player(player)
		else:
			player.volume_db = to_db
		return
	var tween: Tween = create_tween()
	tween.set_ignore_time_scale(true)
	tween.tween_property(player, "volume_db", to_db, seconds)
	tween.tween_callback(_end_fade.bind(player, stop_at_end))
	_music_tweens[player] = tween


func _end_fade(player: AudioStreamPlayer, stop_at_end: bool) -> void:
	_music_tweens.erase(player)
	if stop_at_end:
		player.stop()
		player.volume_db = _music_base_db


func _stop_player(player: AudioStreamPlayer) -> void:
	_kill_fade(player)
	player.stop()
	player.volume_db = _music_base_db


func _kill_fade(player: AudioStreamPlayer) -> void:
	var tween: Tween = _music_tweens.get(player) as Tween
	if tween != null and tween.is_valid():
		tween.kill()
	_music_tweens.erase(player)


## True while a track is fading out to silence (no current track, a fade still
## running): a story scene waits for it, so no music tail plays under a
## briefing (playtest pt7-k review).
func is_fading_out() -> bool:
	return _music_id == &"" and _is_fading()


## True while any music fade or crossfade leg runs (tests).
func _is_fading() -> bool:
	for tween: Tween in _music_tweens.values():
		if tween != null and tween.is_valid() and tween.is_running():
			return true
	return false


func _log_play(id: StringName, fade: float) -> void:
	if fade > 0.0:
		Log.info("audio", "Music '%s' playing (%.2f s fade-in)" % [id, fade])
	else:
		Log.info("audio", "Music '%s' playing" % id)


func _on_music_finished(player: AudioStreamPlayer) -> void:
	if player == _music:
		_music_id = &""
