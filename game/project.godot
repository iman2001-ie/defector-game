; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DEFECTOR"
run/main_scene="res://scenes/sandbox/sandbox.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="DEFECTOR"

[autoload]

Log="*res://autoloads/log.gd"
Events="*res://autoloads/events.gd"
Config="*res://autoloads/config.gd"
PauseArbiter="*res://autoloads/pause_arbiter.gd"
Audio="*res://autoloads/audio.gd"
Feedback="*res://autoloads/feedback.gd"
EntityRegistry="*res://autoloads/entity_registry.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

