[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_shots"
2d_physics/layer_3="enemies"
2d_physics/layer_4="enemy_shots"
2d_physics/layer_5="asteroids"
2d_physics/layer_6="pickups"
2d_physics/layer_7="convoy"
2d_physics/layer_8="allies"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.0196, 0.0275, 0.0588, 1)
viewport/hdr_2d=true
