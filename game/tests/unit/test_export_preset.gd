extends GutTest
## Pins the committed Windows Desktop export preset (relative paths only).

const PRESETS_PATH: String = "res://export_presets.cfg"
## The app icon (exe icon and window icon): one of the two operator-made PNGs
## (playtest 2026-10-14; Story 8.5's SVG retired). The operator switches by
## pointing both project.godot and export_presets.cfg at the other file.
const ICON_CHOICES: Array[String] = [
	"res://assets/icon/defector_icon_ship.png",
	"res://assets/icon/defector_icon_lasers.png",
]
const ICON_PX: int = 256

var _cfg: ConfigFile


func before_each() -> void:
	_cfg = ConfigFile.new()
	assert_eq(_cfg.load(PRESETS_PATH), OK, "export_presets.cfg parses")


func test_preset_header() -> void:
	assert_eq(_cfg.get_value("preset.0", "name", ""), "Windows Desktop")
	assert_eq(_cfg.get_value("preset.0", "platform", ""), "Windows Desktop")
	assert_eq(_cfg.get_value("preset.0", "runnable", false), true)
	assert_eq(_cfg.get_value("preset.0", "export_filter", ""), "all_resources")
	assert_eq(_cfg.get_value("preset.0", "include_filter", ""), "data/*.json")
	assert_eq(_cfg.get_value("preset.0", "exclude_filter", ""), "addons/gut/*, tests/*")
	assert_eq(_cfg.get_value("preset.0", "export_path", ""), "export/windows/DEFECTOR.exe")


func test_preset_options() -> void:
	assert_eq(_cfg.get_value("preset.0.options", "binary_format/embed_pck", false), true)
	assert_eq(_cfg.get_value("preset.0.options", "binary_format/architecture", ""), "x86_64")
	assert_eq(_cfg.get_value("preset.0.options", "application/product_name", ""), "DEFECTOR")
	assert_eq(_cfg.get_value("preset.0.options", "codesign/enable", true), false)
	assert_has(ICON_CHOICES, str(_cfg.get_value("preset.0.options", "application/icon", "")), "the exe carries a DEFECTOR icon")
	# The version lives once, in project.godot: empty (or absent) here, so Godot
	# fills the exe's file and product version from application/config/version.
	assert_eq(_cfg.get_value("preset.0.options", "application/file_version", ""), "", "file_version stays empty")
	assert_eq(_cfg.get_value("preset.0.options", "application/product_version", ""), "", "product_version stays empty")


## Story 8.5: the icon loads as a 256 x 256 texture, and the project uses the
## same file as its window icon.
func test_icon_is_a_256_px_texture() -> void:
	for path: String in ICON_CHOICES:
		var choice: Texture2D = load(path) as Texture2D
		assert_not_null(choice, "%s loads as a Texture2D" % path)
		if choice != null:
			assert_eq(choice.get_size(), Vector2(ICON_PX, ICON_PX), "%s is %d px square" % [path, ICON_PX])
	var icon_path: String = str(_cfg.get_value("preset.0.options", "application/icon", ""))
	var icon: Texture2D = load(icon_path) as Texture2D
	assert_not_null(icon, "%s loads as a Texture2D" % icon_path)
	if icon == null:
		return
	assert_eq(icon.get_width(), ICON_PX, "icon width")
	assert_eq(icon.get_height(), ICON_PX, "icon height")


func test_project_icon_and_version() -> void:
	assert_eq(str(ProjectSettings.get_setting("application/config/icon", "")), str(_cfg.get_value("preset.0.options", "application/icon", "")), "window icon is the exe icon")
	assert_eq(str(ProjectSettings.get_setting("application/config/version", "")), "1.0", "the single version source")


## Story 8.5: release/GODOT_COPYRIGHT.txt (outside res://, shipped in the zip's
## CREDITS.txt) was generated by the engine version that runs the tests.
func test_godot_copyright_matches_the_engine_version() -> void:
	var path: String = ProjectSettings.globalize_path("res://").path_join("../release/GODOT_COPYRIGHT.txt")
	var text: String = FileAccess.get_file_as_string(path)
	assert_ne(text, "", "%s is readable" % path)
	var first_line: String = text.replace("\r\n", "\n").get_slice("\n", 0)
	assert_eq(first_line, "Godot Engine %s" % Engine.get_version_info().string,
		"regenerate it with tools/godot_copyright.gd after an engine upgrade")


func test_no_absolute_paths() -> void:
	var text: String = FileAccess.get_file_as_string(PRESETS_PATH)
	var regex: RegEx = RegEx.create_from_string("(?i)(?<![a-z])[a-z]:[\\\\/]|users[\\\\/]")
	assert_null(regex.search(text), "no drive letters or user folders")


func test_level_files_match_the_include_filter() -> void:
	var filters: PackedStringArray = str(_cfg.get_value("preset.0", "include_filter", "")).split(",", false)
	var files: PackedStringArray = DirAccess.get_files_at("res://data/levels/")
	assert_gt(files.size(), 0, "level files exist")
	for file: String in files:
		if not file.ends_with(".json"):
			continue
		var path: String = "data/levels/" + file
		var matched: bool = false
		for filter: String in filters:
			if path.matchn(filter.strip_edges()):
				matched = true
		assert_true(matched, "%s is exported by the include filter" % path)
