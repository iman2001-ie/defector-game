.claude/settings.json

# Godot (once the game/ project exists)
game/.godot/
game/export/
*.tmp
*.zip
LOCAL.md

# Python bytecode (embeds local absolute paths)
__pycache__/

# Operator art hand-off folder (source drops; the used copies live under game/ and docs/)
defector_cartoon_assets/

# Local music audition clips (not shipped)
music_audition/

# Local reference screenshots (not shipped)
screenshots/
